{
  "name": "notiq",
  "version": "2.0.0",
  "description": "Offline desktop notepad (see app.config.json for user-facing branding).",
  "main": "main.js",
  "author": "Kentarouu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --config electron-builder.config.js --dir",
    "dist": "electron-builder --config electron-builder.config.js --win --x64",
    "measure": "node tools/measure.js . current 3"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
